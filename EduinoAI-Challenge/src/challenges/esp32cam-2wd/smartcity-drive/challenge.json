  "starter_code": {
    "language": "ino-subset",
    "version": 3,
    "source": "#include \"kit.h\"\n\nint SPEED      = {{kit.drive.default_pwm}};\nint SLOW_SPEED = {{derived.slow_pwm}};\nint STOP_MS    = {{derived.stop_hold_ms}};\nint SURE       = 60;\nvoid setup() {\n  mlBegin();\n  stop();\n  delay(500);\n}\n\nvoid loop() {\n  int what = mlClassify();\n  int sure = mlConfidence();\n  if (sure < SURE) what = 0;\n  if (what == 1) {\n    stop();\n    delay(STOP_MS);\n  } else if (what == 2) {\n    moveForward(SLOW_SPEED);\n  } else {\n    moveForward(SPEED);\n  }\n  delay(30);\n}"
  },
