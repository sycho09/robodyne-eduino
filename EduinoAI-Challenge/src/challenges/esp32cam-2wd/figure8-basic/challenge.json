  "series": "RC카 이동제어",
  "track_label": "상급 · 8자 코스",
  "solution_code": {
    "language": "ino-subset",
    "source": "// [설정] 느린 왼쪽 바퀴를 올려 직진을 맞춘다\nint L = {{derived.trim_left_pwm}};\nint R = {{kit.drive.default_pwm}};\nint TURN    = {{derived.spin_pwm}};\nint TURN_MS = {{derived.spin90_ms}};\n\n// [준비]\nvoid setup() {\n  stop();\n  delay(500);\n}\n\n// [주행] 구간마다 직진 시간이 다르다\nvoid loop() {\n  setMotor(L, R);        delay({{derived.seg1_ms}});\n  setMotor(TURN, -TURN); delay(TURN_MS);\n  setMotor(L, R);        delay({{derived.seg2_ms}});\n  setMotor(TURN, -TURN); delay(TURN_MS);\n  setMotor(L, R);        delay({{derived.seg3_ms}});\n  setMotor(TURN, -TURN); delay(TURN_MS);\n  setMotor(L, R);        delay({{derived.seg4_ms}});\n  setMotor(-TURN, TURN); delay(TURN_MS);\n  setMotor(L, R);        delay({{derived.seg5_ms}});\n  setMotor(-TURN, TURN); delay(TURN_MS);\n  setMotor(L, R);        delay({{derived.seg6_ms}});\n  setMotor(-TURN, TURN); delay(TURN_MS);\n}"
  },
