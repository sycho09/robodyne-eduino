  "starter_code": {
    "language": "ino-subset",
    "version": 3,
    "source": "#include \"kit.h\"\n\nint SPEED   = {{kit.drive.default_pwm}};\nint TURN    = {{kit.drive.default_pwm}};\nint TURN_MS = {{derived.turn90_ms}};\n\nvoid setup() {\n  stop();\n  delay(500);\n}\n\nvoid loop() {\n  moveForward(SPEED); delay({{derived.seg1_ms}});\n  turnRight(TURN);    delay(TURN_MS);\n  moveForward(SPEED); delay({{derived.seg2_ms}});\n  turnRight(TURN);    delay(TURN_MS);\n  moveForward(SPEED); delay({{derived.seg3_ms}});\n  turnRight(TURN);    delay(TURN_MS);\n  moveForward(SPEED); delay({{derived.seg4_ms}});\n  turnLeft(TURN);     delay(TURN_MS);\n  moveForward(SPEED); delay({{derived.seg5_ms}});\n  turnLeft(TURN);     delay(TURN_MS);\n  moveForward(SPEED); delay({{derived.seg6_ms}});\n  turnLeft(TURN);     delay(TURN_MS);\n}"
  },
