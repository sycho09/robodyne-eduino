    "rules": {
      "summary": "카메라로 담은 장면으로 정지·서행·진행을 학습시킨다. 기록보다 학습이 목적이라 목표 시간이 없다.",
      "steps": [
        {
          "image": "slot:guide.ml-sign-lab.1",
          "text": "학습 탭으로 — [학습] 탭에서 카메라를 켜고 장면을 담습니다."
        },
        {
          "image": "slot:guide.ml-sign-lab.2",
          "text": "세 칸 채우기 — 정지·서행·진행 세 칸에 골고루 담습니다."
        },
        {
          "image": "slot:guide.ml-sign-lab.3",
          "text": "학습하기 — [학습하기] 를 누르면 지금 무엇으로 보이는지 나옵니다."
        },
        {
          "image": "slot:guide.ml-sign-lab.4",
          "text": "코드로 옮기기 — [코드] 탭에서 판단을 주행으로 옮깁니다."
        }
      ],
      "tune": [
        {
          "name": "SPEED",
          "effect": "진행일 때 주는 PWM."
        },
        {
          "name": "SURE",
          "effect": "이 확신도 아래면 모른다고 봅니다."
        }
      ]
    }
  },
  "mission": {
    "objective": "complete_lap",
    "laps": 1,
    "metrics": [
      {
        "id": "lap_time",
        "source": "engine.lap.last",
        "unit": "ms",
        "label": "현재 랩"
      },
      {
        "id": "best_lap_time",
        "source": "engine.lap.best",
        "unit": "ms",
        "label": "베스트"
      },
      {
        "id": "offtrack_count",
        "source": "engine.events.offtrack",
        "unit": "count",
        "label": "이탈"
      },
      {
        "id": "lap_count",
        "source": "engine.lap.count",
        "unit": "count",
        "label": "완주 랩"
      }
    ]
  },
  "starter_code": {
    "language": "ino-subset",
    "version": 3,
    "source": "#include \"kit.h\"\n\nint SPEED = {{kit.drive.default_pwm}};\nint SURE  = 60;\n\nvoid setup() {\n  mlBegin();\n  stop();\n  delay(500);\n}\n\nvoid loop() {\n  int what = mlClassify();\n  if (mlConfidence() < SURE) what = 0;\n  if (what == 3) {\n    moveForward(SPEED);\n  } else if (what == 2) {\n    moveForward(SPEED / 2);\n  } else {\n    stop();\n  }\n  delay(30);\n}"
  },
  "allowed_api": [
    "setMotor",
    "stop",
    "delay",
    "moveForward",
    "turnLeft",
    "turnRight",
    "mlBegin",
    "mlClassify",
    "mlConfidence"
  ],
  "limits": {
    "max_sim_ticks": 60000,
    "max_catchup_ms": 20,
    "max_code_bytes": 8192,
    "max_ops_per_tick": 200000
  },
  "scoring": {
    "primary": "best_lap_time",
    "order": "asc",
    "display": [
      "lap_time",
      "best_lap_time",
      "offtrack_count",
      "lap_count"
    ],
    "penalty": {
      "offtrack_ticks": 200
    },
    "best_requires": {
      "offtrack": 0,
      "empty_text": "아직 없음 — 코스를 벗어나지 않고 완주해 보세요"
    }
  },
  "rules": {
    "offtrack": {
      "mode": "count_and_end",
      "max_events": 3,
      "hint": "표지판을 잘못 읽으면 멈추거나 늦게 섭니다. [학습] 탭에서 샘플을 더 담아 보세요."
    },
    "timeout": {
      "sim_ticks": 9000
    },
    "penalty": "none",
    "respawn": false,
    "record_incomplete": false
  },
  "series": "RC카 테마학습제어",
  "track_label": "표지판 학습 실험실",
  "guide": [
    {
