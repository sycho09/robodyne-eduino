        "el": "tab-code"
      }
    },
    {
      "text": "다 됐으면 이 버튼을 눌러요.",
      "target": {
        "el": "go"
      }
    }
  ],
  "camera_source": "webcam",
  "ml": {
    "classes": [
      "정지",
      "서행",
