    },
    "actions": [
      {
        "id": "stop",
        "label": "멈춘다",
        "code": "stop();",
        "uses_speed": false,
        "hold": true
      },
      {
        "id": "slow",
        "label": "천천히 간다",
        "code": "setMotor(60, 60);",
        "uses_speed": false,
        "hold": true
      },
      {
        "id": "back",
        "label": "뒤로 물러난다",
        "code": "setMotor(-90, -90);",
        "uses_speed": false,
        "hold": true
      },
      {
        "id": "left",
        "label": "왼쪽으로 돈다",
        "code": "setMotor(-%s, %s);",
        "uses_speed": true,
        "hold": true
      },
      {
        "id": "right",
        "label": "오른쪽으로 돈다",
        "code": "setMotor(%s, -%s);",
        "uses_speed": true,
        "hold": true
      },
      {
        "id": "go",
        "label": "계속 간다",
        "code": "setMotor(%s, %s);",
        "uses_speed": false,
        "hold": false
      }
    ],
    "otherwise": {
      "label": "그 밖에",
      "action_label": "계속 간다",
      "speed": 150,
      "code": "setMotor(150, 150);",
      "why": "배운 것이 하나도 안 보일 때입니다. 코드에서는 else 가 됩니다."
    },
    "code": {
      "var": "seen",
      "classify_call": "mlClassify()",
      "begin_call": "mlBegin()",
      "unknown_value": 0,
      "note": "표에서 만든 코드입니다. 여기서 고친 것은 표로 돌아가지 않습니다 — 표가 원본입니다."
    }
  },
