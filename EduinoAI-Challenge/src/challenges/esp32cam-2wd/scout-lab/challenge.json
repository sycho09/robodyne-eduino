{
  "$schema": "../scout.schema.json",
  "kit_id": "esp32cam-2wd",
  "challenge_id": "scout-lab",
  "version": "1.0.0",
  "mode": 3,
  "title": "RC카 스마트탐사 — 교실 탐사대",
  "description": "실제 RC카를 사람이 몰고, 실제 카메라가 보는 것을 그대로 읽는다. 무대는 교실 바닥이고 대상은 학생이 직접 놓은 물체다. 기록도 순위도 없다 — 남는 것은 탐사 일지와 학습 지표, 그리고 어디까지 갔는지 세 단계뿐이다.",
  "camera_source": "webcam",
  "deterministic": false,
  "deterministic_note": "이 챌린지만 결정론이 성립하지 않는다. 사람이 조종하고 실물 카메라가 입력이기 때문이며, 그것이 이 챌린지의 목적이다. 랩타임 기준값 대상이 아니고 순위도 만들지 않는다. 다른 챌린지의 결정론은 이 예외와 무관하다.",
  "scene": {
    "units": "mm",
    "summary": "카메라로 보고, 배우고, 배운 것으로 알아본다",
    "ui": {
      "quad": {
        "slots": [
          "raw",
          "ai",
          "night",
          "edge"
        ],
        "options": [
          {
            "id": "raw",
            "label": "일반",
            "sensor": "camera"
          },
          {
            "id": "ai",
            "label": "객체 인식",
            "sensor": "camera"
          },
          {
            "id": "thermal",
            "label": "열화상",
            "sensor": "mlx90640",
            "grid": [
              32,
              24
            ]
          },
          {
            "id": "night",
            "label": "야간 보정",
            "sensor": "camera",
            "note": "IR 조명이 아니라 어두운 그림의 밝기를 끌어올린 것입니다."
          },
          {
            "id": "track",
            "label": "관심점 추적",
