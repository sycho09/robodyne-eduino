  "mission": {
    "goal": "교실을 돌며 물체를 찾고, 카메라가 본 것으로 그 물체를 구별하는 눈을 만든다.",
    "no_score": "채점 없음 — 남는 것은 일지 · 학습 지표 · 도달 단계 셋뿐입니다."
  },
  "scout": {
    "classes": {
