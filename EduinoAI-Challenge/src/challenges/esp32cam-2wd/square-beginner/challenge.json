  "starter_code": {
    "language": "ino-subset",
    "version": 3,
    "source": "#include \"kit.h\"\n\nint SPEED = {{kit.drive.default_pwm}};\nint TURN  = {{kit.drive.default_pwm}};\n\nvoid setup() {\n  stop();\n  delay(500);\n}\n\nvoid loop() {\n  moveForward(SPEED);\n  delay({{derived.side_ms}});\n  turnRight(TURN);\n  delay({{derived.turn90_ms}});\n}"
  },
  "allowed_api": [
    "stop",
    "delay",
    "moveForward",
    "moveBackward",
    "turnLeft",
    "turnRight"
  ],
  "limits": {
    "max_sim_ticks": 60000,
    "max_catchup_ms": 20,
    "max_code_bytes": 8192,
    "max_ops_per_tick": 200000
  },
  "scoring": {
    "primary": "best_lap_time",
    "order": "asc",
    "display": [
      "lap_time",
      "best_lap_time",
      "offtrack_count",
      "lap_count"
    ],
    "penalty": {
      "offtrack_ticks": 200
    },
    "best_requires": {
      "offtrack": 0,
      "empty_text": "아직 없음 — 코스를 벗어나지 않고 완주해 보세요"
    },
    "goal_ticks": 1500
  },
  "rules": {
    "offtrack": {
      "mode": "count_and_end",
      "max_events": 3,
      "hint": "속도를 너무 올리면 회전 시간이 안 맞아 코스를 벗어납니다. SPEED 를 올렸으면 delay 도 같이 줄여 보세요."
    },
    "timeout": {
      "sim_ticks": 6000
    },
    "penalty": "none",
    "respawn": false,
    "record_incomplete": false
  },
  "series": "RC카 이동제어",
  "track_label": "초급 · 사각 코스",
  "solution_code": {
    "language": "ino-subset",
    "source": "// [설정] 낼 수 있는 최대 속도로 달린다\nint SPEED = {{derived.full_pwm}};   // 이 킷의 최대 PWM\nint TURN  = {{derived.spin_pwm}};   // 90도가 10ms 단위에 딱 떨어지는 회전 PWM\n\n// [준비]\nvoid setup() {\n  stop();\n  delay(500);\n}\n\n// [주행] 속도를 올린 만큼 직진 시간은 줄어든다\nvoid loop() {\n  moveForward(SPEED);\n  delay({{derived.side_full_ms}});   // 한 변 {{scene.track.center_side_mm}}mm\n  turnRight(TURN);\n  delay({{derived.spin90_ms}});      // 90도\n}"
  },
  "guide": [
    {
      "text": "여기서 코드를 고쳐요.",
      "target": {
        "el": "editor-mount"
      }
    },
    {
      "text": "이 숫자가 속도예요.",
      "target": {
        "anchor": {
          "find": "int SPEED",
          "nth": 1
        }
      }
    },
    {
      "text": "이 숫자가 시간이에요.",
      "target": {
        "anchor": {
          "find": "delay(",
          "nth": 2
        }
      }
    },
    {
      "text": "다 고쳤으면 이 버튼을 눌러요.",
      "target": {
        "el": "go"
      }
    },
    {
      "text": "여기서 RC카가 달려요.",
      "target": {
        "el": "canvas"
      }
    },
    {
      "text": "여기서 기록을 봐요.",
      "target": {
        "el": "record-plain"
      }
    }
  ],
  "record": {
    "fields": [
      "lap_total",
      "lap_splits",
      "path_image"
    ]
  }
