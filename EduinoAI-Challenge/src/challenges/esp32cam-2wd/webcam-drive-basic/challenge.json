  "starter_code": {
    "language": "ino-subset",
    "version": 3,
    "source": "#include \"kit.h\"\n\nint SPEED = {{kit.drive.default_pwm}};\nint GAIN  = {{derived.camera_gain}};\nint DEAD  = {{derived.camera_dead}};\n\nvoid setup() {\n  cameraSetTarget({{derived.camera_r}}, {{derived.camera_g}}, {{derived.camera_b}}, {{derived.camera_tol}});\n  stop();\n  delay(500);\n}\n\nvoid loop() {\n  int off = cameraOffset();\n  if (off > DEAD || off < -DEAD) {\n    int turn = off * GAIN / 100;\n    setMotor(SPEED, SPEED - turn);\n  } else {\n    moveForward(SPEED);\n  }\n  delay(30);\n}"
  },
  "allowed_api": [
    "setMotor",
    "stop",
    "delay",
    "moveForward",
    "moveBackward",
    "turnLeft",
    "turnRight",
    "cameraSetTarget",
    "cameraFound",
    "cameraOffset",
    "cameraArea"
  ],
  "limits": {
