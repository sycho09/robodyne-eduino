  "starter_code": {
    "language": "ino-subset",
    "version": 4,
    "source": "#include \"kit.h\"\n\nint LEFT  = {{kit.drive.default_pwm}};\nint RIGHT = {{kit.drive.default_pwm}};\nint TURN  = {{kit.drive.default_pwm}};\n\nvoid setup() {\n  stop();\n  delay(500);\n}\n\nvoid loop() {\n  setMotor(LEFT, RIGHT);\n  delay({{derived.side_ms}});\n  turnRight(TURN);\n  delay({{derived.turn90_ms}});\n}"
  },
