        "id": "lap_time",
        "source": "engine.lap.last",
        "unit": "ms",
        "label": "현재 랩"
      },
      {
        "id": "best_lap_time",
        "source": "engine.lap.best",
        "unit": "ms",
        "label": "베스트"
      },
      {
        "id": "offtrack_count",
        "source": "engine.events.offtrack",
        "unit": "count",
        "label": "이탈"
      },
      {
        "id": "lap_count",
        "source": "engine.lap.count",
        "unit": "count",
        "label": "완주 랩"
      }
    ]
  },
  "starter_code": {
    "language": "ino-subset",
    "version": 3,
    "source": "#include \"kit.h\"\n\nint SPEED = {{kit.drive.default_pwm}};\nint TURN  = {{kit.drive.default_pwm}};\n\nvoid setup() {\n  stop();\n  delay(500);\n}\n\nvoid loop() {\n  for (int i = 0; i < 4; i++) {\n    moveForward(SPEED);\n    delay({{derived.side_ms}});\n\n    turnRight(TURN);\n    delay({{derived.turn90_ms}});\n  }\n}"
  },
  "allowed_api": [
    "setMotor",
    "stop",
    "delay",
    "moveForward",
    "moveBackward",
    "turnLeft",
    "turnRight"
  ],
  "limits": {
    "max_sim_ticks": 60000,
    "max_catchup_ms": 20,
    "max_code_bytes": 8192,
    "max_ops_per_tick": 200000
  },
  "scoring": {
    "primary": "best_lap_time",
    "order": "asc",
    "display": [
      "lap_time",
      "best_lap_time",
      "offtrack_count",
      "lap_count"
    ],
    "penalty": {
      "offtrack_ticks": 200
    },
    "best_requires": {
      "offtrack": 0,
      "empty_text": "아직 없음 — 코스를 벗어나지 않고 완주해 보세요"
    }
  },
  "rules": {
    "offtrack": {
      "mode": "count_and_end",
      "max_events": 2
    },
    "timeout": {
      "sim_ticks": 2500
    },
    "penalty": "none",
    "respawn": false,
    "record_incomplete": false
  },
  "series": "RC카 타임어택",
  "track_label": "사각 코스 · 상급",
  "record": {
    "fields": [
