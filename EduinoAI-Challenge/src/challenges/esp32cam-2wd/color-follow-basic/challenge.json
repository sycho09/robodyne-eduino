  "solution_code": {
    "language": "ino-subset",
    "source": "// [설정] NEAR 를 코너에 닿는 크기로 맞춘 코드\n//   마커는 코너를 지나 {{derived.marker_ahead_mm}}mm 앞에 서 있다.\n//   그 거리에서 마커가 화면에서 차지하는 크기가 {{derived.marker_near_area}} 이다.\nint SPEED = {{kit.drive.default_pwm}};\nint TURN  = {{derived.spin_pwm}};\nint TURN_MS = {{derived.spin90_ms}};\nint GAIN  = 60;\nint NEAR  = {{derived.marker_near_area}};   // 코너에 닿는 순간의 크기\n\n// [준비]\nvoid setup() {\n  cameraSetTarget(187, 59, 66);\n  stop();\n  delay(500);\n}\n\n// [주행] 이 킷은 좌우 모터 특성이 달라 그냥 두면 휜다.\n// 마커가 화면 가운데 오도록 좌우 바퀴를 조금씩 다르게 주는 것이 핵심이다.\nvoid loop() {\n  if (cameraFound() && cameraArea() >= NEAR) {\n    turnLeft(TURN);\n    delay(TURN_MS);\n  } else if (cameraFound()) {\n    int off = cameraOffset();\n    setMotor(SPEED + off * GAIN / 100, SPEED - off * GAIN / 100);\n    delay(20);\n  } else {\n    moveForward(SPEED);\n    delay(20);\n  }\n}"
  },
  "record": {
    "fields": [
      "lap_total",
      "lap_splits"
    ]
  }
}
