  "starter_code": {
    "language": "ino-subset",
    "version": 3,
    "source": "#include \"kit.h\"\n\nint SPEED = {{kit.drive.default_pwm}};\nint TURN  = {{derived.spin_pwm}};\nint TURN_MS = {{derived.spin90_ms}};\nint GAIN  = 60;\nint NEAR  = 25;\n\nvoid setup() {\n  cameraSetTarget(187, 59, 66);\n  stop();\n  delay(500);\n}\n\nvoid loop() {\n  int area = 0;\n  if (cameraFound()) area = cameraArea();\n  if (area >= NEAR) {\n    turnLeft(TURN);\n    delay(TURN_MS);\n  } else if (cameraFound()) {\n    int off = cameraOffset();\n    int turn = off * GAIN / 100;\n    setMotor(SPEED + turn, SPEED - turn);\n    delay(20);\n  } else {\n    moveForward(SPEED);\n    delay(20);\n  }\n}"
  },
  "allowed_api": [
    "setMotor",
    "stop",
    "delay",
    "moveForward",
    "moveBackward",
    "turnLeft",
    "turnRight",
    "cameraSetTarget",
    "cameraFound",
    "cameraOffset",
    "cameraArea"
  ],
